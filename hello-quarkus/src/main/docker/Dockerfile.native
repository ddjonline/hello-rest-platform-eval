####
# This Dockerfile is used in order to build a container that runs the Quarkus application in native (no JVM) mode
#
# Before building the docker image run:
#
# mvn package -Pnative
#
# Then, build the image with:
#
# docker build -f src/main/docker/Dockerfile.native -t quarkus/hello-quarkus .
#
# Then run the container using:
#
# docker run -i --rm -p 8080:8080 quarkus/hello-quarkus
#
###
FROM quay.io/quarkus/quarkus-micro-image:3.0
WORKDIR /work/
COPY target/*-runner /work/application
RUN chmod 775 /work
EXPOSE 8080
CMD ["./application", "-Dquarkus.http.host=[IP_ADDRESS]"]
