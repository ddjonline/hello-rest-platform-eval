####
# Build the app first:
#   mvn -pl hello-openliberty -am package
#
# Build image from hello-openliberty/:
#   docker build -f src/main/docker/Dockerfile.jvm -t hello-openliberty:java25 .
#
# Run:
#   docker run --rm -p 8080:8080 hello-openliberty:java25
###
FROM icr.io/appcafe/open-liberty:kernel-slim-java25-openj9-ubi-minimal

COPY --chown=1001:0 src/main/liberty/config/ /config/
COPY --chown=1001:0 target/hello-openliberty.war /config/apps/

RUN features.sh
